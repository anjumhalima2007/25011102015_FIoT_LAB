--cpu=Cortex-M4.fp.sp
"i2c bme280\startup_stm32f401xe.o"
"i2c bme280\main.o"
"i2c bme280\stm32f4xx_it.o"
"i2c bme280\stm32f4xx_hal_msp.o"
"i2c bme280\bme280.o"
"i2c bme280\stm32f4xx_hal_i2c.o"
"i2c bme280\stm32f4xx_hal_i2c_ex.o"
"i2c bme280\stm32f4xx_hal_rcc.o"
"i2c bme280\stm32f4xx_hal_rcc_ex.o"
"i2c bme280\stm32f4xx_hal_flash.o"
"i2c bme280\stm32f4xx_hal_flash_ex.o"
"i2c bme280\stm32f4xx_hal_flash_ramfunc.o"
"i2c bme280\stm32f4xx_hal_gpio.o"
"i2c bme280\stm32f4xx_hal_dma_ex.o"
"i2c bme280\stm32f4xx_hal_dma.o"
"i2c bme280\stm32f4xx_hal_pwr.o"
"i2c bme280\stm32f4xx_hal_pwr_ex.o"
"i2c bme280\stm32f4xx_hal_cortex.o"
"i2c bme280\stm32f4xx_hal.o"
"i2c bme280\stm32f4xx_hal_exti.o"
"i2c bme280\system_stm32f4xx.o"
--strict --scatter "i2C BME280\i2C BME280.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "i2C BME280.map" -o "i2C BME280\i2C BME280.axf"