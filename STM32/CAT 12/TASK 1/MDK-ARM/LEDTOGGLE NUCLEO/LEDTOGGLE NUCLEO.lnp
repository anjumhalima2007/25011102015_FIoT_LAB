"ledtoggle nucleo\stm32f4xx_it.o"
"ledtoggle nucleo\stm32f4xx_hal_msp.o"
"ledtoggle nucleo\stm32f4xx_hal_rcc.o"
"ledtoggle nucleo\stm32f4xx_hal_rcc_ex.o"
