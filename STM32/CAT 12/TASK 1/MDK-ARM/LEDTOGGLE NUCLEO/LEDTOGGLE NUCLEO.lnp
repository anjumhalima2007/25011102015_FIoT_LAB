"ledtoggle nucleo\stm32f4xx_hal_flash_ex.o"
"ledtoggle nucleo\stm32f4xx_hal_flash_ramfunc.o"
"ledtoggle nucleo\stm32f4xx_hal_gpio.o"
"ledtoggle nucleo\stm32f4xx_hal_dma_ex.o"
"ledtoggle nucleo\stm32f4xx_hal_dma.o"
"ledtoggle nucleo\stm32f4xx_hal_pwr.o"
